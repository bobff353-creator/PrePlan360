# Server-only webhook settings. Add values through Sites hosting; never expose them in browser code.
CAD_WEBHOOK_SECRET=
RESEND_WEBHOOK_SECRET=

# Optional until inbound email body or attachment retrieval is approved.
RESEND_API_KEY=

# Server-only read credential for Stickney Firehouse Manager records.
# Configure in Vercel; never expose through a NEXT_PUBLIC_ variable.
STICKNEY_DATABASE_SECRET=

# Google Maps JavaScript browser keys are intentionally returned to the browser.
# Restrict them in Google Cloud by Maps JavaScript API and approved HTTPS referrers.
GOOGLE_MAPS_BROWSER_KEY=
# Optional JSON map of department slug to separate restricted browser key.
GOOGLE_MAPS_DEPARTMENT_KEYS_JSON=
# Optional Google Cloud map ID for styled department maps.
GOOGLE_MAPS_MAP_ID=

# Base64-encoded 32-byte key used only on the server to encrypt per-department
# CAD, Resend, and export secrets stored in Postgres.
INTEGRATION_ENCRYPTION_KEY=

# Vercel sends this server-only bearer value to the daily export cron route.
CRON_SECRET=
